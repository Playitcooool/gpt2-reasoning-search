# Copy to config/ssh.env. Bash syntax is supported; do not put secrets in this file.

# Put caches on the school's fast scratch disk. $SCRATCH is common on clusters.
TRAIN_CACHE="${SCRATCH:-$HOME/.cache}/gpt2-reasoning-search"
SESSION_PREFIX="grs"
AUTO_RESUME=1
TRAIN_PROFILE="8h"
ALLOW_COMBINED_JOB=0

# Input and artifact paths (relative paths are resolved from the repository root).
TOKENIZER_INPUT_DIR="data/tokenizer-sample"
TOKENIZER_PATH="artifacts/tokenizer.json"
EVALUATION_PROMPTS="data/evaluation/contamination-prompts.jsonl"
REASONING_TOKENS="data/processed/reasoning.bin"
GENERAL_TOKENS="data/processed/general.bin"
WIKIPEDIA_JSONL="data/raw/wikipedia.jsonl"
GROUNDED_QUESTIONS="data/raw/grounded-questions.jsonl"
RL_PROMPTS="data/rl/search-qa.jsonl"
TRAJECTORIES="data/processed/tool-trajectories.jsonl"
WIKI_INDEX="artifacts/wiki-index"

# Data caps. Lower these for a first trial.
REASONING_TOKEN_CAP=2000000000
GENERAL_TOKEN_CAP=1000000000
LEXICAL_ONLY=0

# Eight-hour reservation profile. Prepare data before the GPU job; do not spend the reservation on
# the three proxy ablations. Each stage trains for about 7.5 hours and leaves 30 minutes for
# scheduler/model startup and checkpoint finalization. Set PREPARE_IN_JOB=1 only when the compute
# node has network access.
PREPARE_IN_JOB=0
RUN_SMOKE=1
RUN_PROXIES=0
RUN_PRETRAIN=1
RUN_SFT=1
RUN_RL=1

# One-H100 schedule.
CHECKPOINT_ROOT="checkpoints"
PROXY_TOKEN_CAP=150000000
PROXY_HOURS=1.5
MAIN_TOKEN_CAP=2500000000
MAIN_HOURS=7.5
MAIN_OUTPUT="checkpoints/main-350m"

# Post-training.
SFT_OUTPUT="checkpoints/tool-sft"
SFT_EPOCHS=4
SFT_HOURS=7.5
SFT_MICRO_BATCH=4
SFT_GRAD_ACCUM=8
RL_OUTPUT="checkpoints/search-rl"
RL_EPOCHS=8
RL_HOURS=7.5
RL_GROUP_SIZE=4
USE_LLM_JUDGE=1

# Optional Slurm values. Ask your school for partition/account names.
SLURM_PARTITION=""
SLURM_ACCOUNT=""
SLURM_GRES="gpu:1"
SLURM_CPUS=16
SLURM_MEMORY="128G"
SLURM_TIME="08:00:00"
